{
  "name": "com.layer-note.cep",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20",
    "yarn": ">=1 <2"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "watch": "tsc && vite build --watch true",
    "build": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && vite build --watch false",
    "zxp": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZXP_PACKAGE=true vite build --watch false",
    "zip": "rimraf dist/* && tsc -p \"tsconfig-build.json\" && cross-env ZIP_PACKAGE=true vite build --watch false",
    "serve": "cross-env SERVE_PANEL=true vite preview",
    "symlink": "cross-env BOLT_ACTION=symlink vite",
    "delsymlink": "cross-env BOLT_ACTION=delsymlink vite",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=\"test/(?!integration|e2e)\"",
    "test:integration": "jest --testPathPattern=\"test/integration\"",
    "test:e2e": "jest --testPathPattern=\"test/e2e\"",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "lint": "eslint src/js --ext .ts,.tsx --report-unused-disable-directives --max-warnings 100",
    "lint:ci": "eslint src/js --ext .ts,.tsx --report-unused-disable-directives",
    "lint:fix": "eslint src/js --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "analyze": "npx vite-bundle-analyzer",
    "clean": "rimraf dist build coverage",
    "validate": "npm run type-check && npm run lint && npm run test:ci"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^0.542.0",
    "monaco-editor": "^0.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^3.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/trusted-types": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-require": "^4.0.3",
    "babel-plugin-transform-scss": "^1.2.0",
    "babel-preset-env": "^1.7.0",
    "core-js": "^3.50.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fs-extra": "^10.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^3.0.2",
    "rollup": "^4.62.4",
    "rollup-plugin-multi-input": "^1.9.0",
    "rollup-plugin-node-copy": "^1.0.4",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.102.0",
    "source-map": "^0.7.6",
    "ts-jest": "^29.4.12",
    "types-for-adobe": "^7.2.5",
    "types-for-adobe-extras": "^0.0.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-cep-plugin": "^2.2.3"
  }
}